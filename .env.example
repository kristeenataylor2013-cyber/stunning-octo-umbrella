# Copy to .env (never commit). Credentials may instead live in the OS keyring.
SITE_BASE_URL=https://portal.example.com
SITE_LOGIN_PATH=/login
SITE_CLIENTS_PATH=/clients
SITE_USERNAME=
SITE_PASSWORD=
# Must be OUTSIDE the repository
OUTPUT_DIR=/secure/client-docs
# Saved browser session (for MFA/SSO: run `login-interactive` once)
SESSION_STATE=/secure/client-docs-session.json
# CSS selectors for your site
SEL_USERNAME=input[name=username]
SEL_PASSWORD=input[name=password]
SEL_SUBMIT=button[type=submit]
SEL_CLIENT_LINK=a.client-link
SEL_NEXT_PAGE=a.next
SEL_DOC_LINK=a.document-link
